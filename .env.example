# OpenAI-compatible API (required for chat + embeddings)
OPENAI_API_KEY=sk-...
# Optional: custom base URL (e.g. https://api.openai.com/v1 or a proxy)
OPENAI_BASE_URL=
# Chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# GitHub token for listing/cloning repos (or use: gh auth token)
GITHUB_TOKEN=
GH_TOKEN=

# Include the mega-snapshot repo fitzyracing1/fitzyracing1 (default: false)
INCLUDE_MEGA_SNAPSHOT=false

# Optional overrides
GITHUB_OWNER=fitzyracing1
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DATA_DIR=./data
